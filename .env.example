# Copy to .env (gitignored). Never commit real values.
SEPOLIA_RPC=https://eth-sepolia.g.alchemy.com/v2/<key>   # must serve historical state (forks); publicnode cannot

# Keys. Save any key you generate here BEFORE funding it.
ALICE_KEY=0x...      # owns leash.eth and Alice's ENSv2 registry (deploy scripts)
OWNER_KEY=0x...      # Vault owner; a plain, fresh key (no 7702 delegation, not shared with any bot)
OWNER=0x...
AGENT_KEY=0x...      # holds MANDATE on agent.leash.eth; runs agent/loop.mjs
AGENT=0x...
BACKEND_KEY=0x...    # tier-admin at the registry root; the only caller of Vault.verify()
BACKEND=0x...
TAKER_KEY=0x...      # "the market" in the demo (agent/market.mjs)
TAKER=0x...

# World ID (Developer Portal, or the portal MCP: see docs/SETUP.md §5)
WORLD_APP_ID=app_...
WORLD_RP_ID=rp_...
WORLD_RP_SIGNING_KEY=0x...
WORLD_ACTION=leash-verify
WORLD_ENVIRONMENT=staging          # production for a real World App
WORLD_CREDENTIALS=proof_of_human   # simulator; default (all four) for a phone
WORLD_STAGING_TOKEN=               # from set_world_id_staging_verification; staging only
WORLD_ALLOW_LEGACY=0               # 1 lets phones without native World ID 4.0 answer with 3.0 proofs

# Backend
PORT=8787
DEMO_OWNER_KEY=                    # = OWNER_KEY to enable /api/demo/* (Alice's owner actions)
DEMO_TOKEN=                        # required for demo routes from non-local callers
